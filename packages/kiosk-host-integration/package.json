{
  "name": "@tripley-kit/web-container-kiosk-host-integration",
  "version": "0.1.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tripley-kit/web-container-deposit-orchestration": "0.1.2",
    "@tripley-kit/web-container-host-message": "0.1.0",
    "@tripley-kit/web-container-kiosk-host-delivery": "0.1.1",
    "@tripley-kit/web-container-native-adapter": "0.1.0",
    "@tripley-kit/web-container-withdrawal-orchestration": "0.1.5"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
