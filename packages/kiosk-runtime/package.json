{
  "name": "@tripley-kit/web-container-kiosk-runtime",
  "version": "0.1.7",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tripley-kit/web-container-command-system": "workspace:*",
    "@tripley-kit/web-container-condition-engine": "workspace:*",
    "@tripley-kit/web-container-device-core": "workspace:*",
    "@tripley-kit/web-container-errors": "workspace:*",
    "@tripley-kit/web-container-event-bus": "workspace:*",
    "@tripley-kit/web-container-flow-engine": "workspace:*",
    "@tripley-kit/web-container-kiosk-base": "workspace:*",
    "@tripley-kit/web-container-logging": "workspace:*",
    "@tripley-kit/web-container-plugin-system": "workspace:*",
    "@tripley-kit/web-container-prompt-presentation": "workspace:*",
    "@tripley-kit/web-container-scoped-store": "workspace:*",
    "@tripley-kit/web-container-storage-core": "workspace:*",
    "@tripley-kit/web-container-types": "workspace:*",
    "@tripley-kit/web-container-ui-port": "workspace:*",
    "@tripley-kit/web-container-tts": "workspace:*",
    "@tripley-kit/web-container-window-manager": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
