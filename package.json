{
  "name": "tripley-acctron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --passWithNoTests",
    "test:xfs-hostd": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-xfs-hostd.ps1",
    "test:xfs-hostd:contract": "pnpm --filter @tripley-kit/web-container-kiosk-runtime build && pnpm --filter @tripley-kit/web-container-xfs-device-service build && vitest run --config packages/xfs-test-harness/vitest.config.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "overrides": {
      "@tripley-kit/xrpc-runtime": "file:../../front-end/tripley-kit/libs/xrpc-runtime"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
