        "cim.escrowHeld": { "kind": "cimRollbackThenAwaitTake", "logicalService": "CIM", "timeoutMs": 30000 },
        "cim.customerAccessible": { "kind": "waitUntilDeadlineThenCimRetract", "logicalService": "CIM", "outputPosition": 512, "retractArea": 2, "index": 1, "timeoutMs": 30000 },
        "idc.cardInside": { "kind": "idcEjectThenAwaitTake", "logicalService": "IDC", "ejectPosition": 1, "timeoutMs": 30000 },
        "idc.customerAccessible": { "kind": "waitUntilDeadlineThenIdcRetain", "logicalService": "IDC", "timeoutMs": 30000 }
      }
